# Copy to `.env` and fill in. Never commit the real file.

# --- LLM provider: groq | openai | anthropic | ollama -------------------------------------
LLM_PROVIDER=groq
# Leave empty to use the provider default (groq: llama-3.3-70b-versatile, openai: gpt-4o-mini,
# anthropic: claude-3-5-haiku-latest, ollama: llama3.1). Must be a tool-calling capable model.
LLM_MODEL=

# Only the key for the selected provider is needed. Groq has a free tier: https://console.groq.com/keys
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (fully local, no key). With docker-compose the default is the host machine.
# For a non-Docker local run use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Optional tuning -----------------------------------------------------------------------
# LLM_TEMPERATURE=0
# RAG_TOP_K=3
# RAG_MAX_DISTANCE=0.5
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Local (non-Docker) paths; defaults are fine ---------------------------------------------
# CLAIMS_FILE_PATH=./storage/mock_claims.json
# CHROMA_PATH=./storage/chroma

# --- Frontend (local run only; docker-compose sets this for you) ----------------------------
# BACKEND_URL=http://localhost:8000
